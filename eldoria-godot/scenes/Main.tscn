[sub_resource type="ProceduralSkyMaterial" id="Sky_procedural"]
; 2026-05-07: replaced panorama sunset JPG (had baked white clouds that
; jm couldn't stand) with a clean procedural gradient. No clouds, ever.
sky_top_color = Color(0.32, 0.20, 0.36, 1)
sky_horizon_color = Color(0.72, 0.38, 0.18, 1)
sky_curve = 0.40
ground_horizon_color = Color(0.55, 0.40, 0.32, 1)
ground_bottom_color = Color(0.10, 0.08, 0.10, 1)
ground_curve = 0.05
sun_angle_max = 25.0
sun_curve = 0.15

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("Sky_procedural")
radiance_size = 4

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
; REFINE: visual — outdoor — warmer ambient (was 0.82,0.81,0.88 cool-blue) so even midday sits in THEME §3 sunset-gold/wine palette instead of leaning Nordic-cool.
ambient_light_color = Color(0.86, 0.82, 0.82, 1)
; REFINE: visual — outdoor — ambient energy 0.50 → 0.46. THEME §3 wants warm directional dominance; flatter ambient was muddying lantern/chest emission contrast.
ambient_light_energy = 0.46
ambient_light_sky_contribution = 0.40 ; 2026-05-07: 0.85 -> 0.40 (was bleeding sky color into every surface)
tonemap_mode = 3
; REFINE: visual — outdoor — exposure 0.92 → 0.94. Slightly opens midtones for painterly readability per THEME §1; sun cap at energy 1.9 means no blowout.
tonemap_exposure = 0.94
tonemap_white = 5.5
glow_enabled = true
glow_intensity = 0.55
glow_strength = 1.05
glow_bloom = 0.10
glow_blend_mode = 1
glow_hdr_threshold = 0.58
ssao_enabled = true
ssao_intensity = 2.10
ssao_radius = 1.6
ssao_power = 1.85
ssil_enabled = false
ssr_enabled = true
ssr_max_steps = 32
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.04
; REFINE: visual — outdoor — saturation 1.16 → 1.18. THEME §1 painterly + §11 BotW reference; nudges palette away from photoreal-grey.
adjustment_saturation = 1.18
fog_enabled = true
; REFINE: visual — outdoor — fog tint warmer (R 0.92→0.94, G 0.78→0.80, B 0.62→0.60). Pairs with World.gd dusk-density swing so god-rays read sunset-gold not paper-white.
fog_light_color = Color(0.94, 0.80, 0.60, 1)
fog_light_energy = 0.5
fog_density = 0.0012 ; 2026-05-08: 0.0018 -> 0.0012 (reduced to clear sky horizon)
fog_sky_affect = 0.10 ; 2026-05-08: 0.7 -> 0.10 (fog was washing out horizon sky)
fog_height = 0.0
fog_height_density = 0.05
volumetric_fog_enabled = true
volumetric_fog_density = 0.0018 ; 2026-05-07: 0.004 -> 0.0018 (vol-fog over 110m was erasing distance)
; REFINE: visual — outdoor — vol-fog albedo nudged toward parchment/sepia (#D9C99B family) per THEME §3.
volumetric_fog_albedo = Color(0.88, 0.82, 0.74, 1)
volumetric_fog_emission = Color(0.4, 0.2, 0.05, 1)
volumetric_fog_emission_energy = 0.16
volumetric_fog_length = 110.0
volumetric_fog_detail_spread = 2.0

