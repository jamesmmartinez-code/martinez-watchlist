[gd_resource type="Resource" format=3]

; Recipe — Forge Iron Sword (from raw stock)
; Lore: items_flavor.json iron_sword — "Edda's standard work — straight, honest, weighted to the elbow"
; # NEEDS:item:iron_ingot, charcoal, leather_strip

[resource]
resource_name = "Forge Iron Sword"
metadata/schema = "recipes/_schema_v1"
