[gd_resource type="Resource" format=3]

; Recipe — Hammer Chainmail Ring-Shirt
; Lore: items_flavor.json chainmail — "Iron Crown work, three years on the road…
;        Edda has retempered the rivets; Roan has restitched the under-tunic"
; This is the local re-tempering recipe — village gets you a chainmail by mending an Iron-Crown shirt frame.
; # NEEDS:item:iron_ingot, leather_strip, ring_blanks (or: re-temper input)

[resource]
resource_name = "Mend the Ring-Shirt"
metadata/schema = "recipes/_schema_v1"
metadata/id = "forge_chainmail_mend"
metadata/name = "Mend the Ring-Shirt"
metadata/station_required = "edda_forge"
metadata/station_tier_min = 1
metadata/inputs = [
    {"item_id": "iron_ingot", "qty": 4},
    {"item_id": "leather_strip", "qty": 2},
    {"item_id": "charcoal", "qty": 2}
]
metadata/output = {"item_id": "chainmail", "qty": 1}
metadata/time_seconds = 22
metadata/fuel_cost = 2
metadata/unlock_condition = "quest_complete"
metadata/unlock_quest = "iron_crown_ringshirt_recovered"
metadata/unlock_hint = "Recover an Iron-Crown ring-shirt frame on the Whisperwood road, then bring it to Edda."
metadata/failure_behavior = "none"
metadata/category = "armor_metal"
metadata/teach_voice = "Edda: 'Three hands have kept this. The fourth is yours. Sit. Help me with the shoulder-kink.'"
