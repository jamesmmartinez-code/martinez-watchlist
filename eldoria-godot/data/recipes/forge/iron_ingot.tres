[gd_resource type="Resource" format=3]

; Recipe — Smelt Iron Ingot
; Bootstrap material recipe. iron_ingot does not yet exist in items_flavor.json.
; # NEEDS:item:iron_ore  — raw input
; # NEEDS:item:iron_ingot — output (refined bar; tier-1 currency for blade/armor work)
; # NEEDS:item:charcoal  — fuel + reducing agent
; Lore note for item-designer: "Edda quenches in pond-water on the morning after a Foxthaw — pond-water remembers"

[resource]
resource_name = "Smelt Iron Ingot"
metadata/schema = "recipes/_schema_v1"
metadata/id = "forge_iron_ingot"
metadata/name = "Smelt Iron Ingot"
metadata/station_required = "edda_forge"
metadata/station_tier_min = 1
metadata/inputs = [
    {"item_id": "iron_ore", "qty": 2},
    {"item_id": "charcoal", "qty": 1}
]
metadata/output = {"item_id": "iron_ingot", "qty": 1}
metadata/time_seconds = 6
metadata/fuel_cost = 1
metadata/unlock_condition = "auto"
metadata/failure_behavior = "none"
metadata/category = "ingot"
metadata/teach_voice = "Edda, hammer-clang: 'Two stone, one charcoal. Don't crowd the bed.'"
