[gd_resource type="Resource" format=3]

; Recipe — Press Lesser Health Potion
; Lore-anchored verbatim from items_flavor.json hp_potion_s:
;   "Heart's-ease for what aches inside; dogwort for what aches outside; marshmint for both
;    — pressed warm in a small clay flask sealed with beeswax and a thumbprint."
; # NEEDS:item:herb_hearts_ease, herb_dogwort, herb_marshmint, beeswax_dab, clay_flask_empty

[resource]
