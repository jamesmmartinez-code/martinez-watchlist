[gd_resource type="Resource" format=3]

; Recipe — Stitch Leather Vest
; Tier-2 — Lyra's stitched leather vest, the one Roan-the-vendor sells in town
; (this recipe is the same pattern, taught by Lyra to the player after enough cured pelts).
; New-region ingredient: cured Whisperwood wolf leather (leather_strip × 8).
; OUTPUT exists in catalog: leather (Leather Vest, armor, tier 2).
; # NEEDS:item:leather_strip, hemp_cord (already flagged in tier-1 README)
; # NEEDS:item:bone_needle (Whisperwood salvage; pierces the back-seam)

[resource]
resource_name = "Stitch Leather Vest"
metadata/schema = "recipes/_schema_v1"
metadata/id = "herbshed_leather_vest"
metadata/name = "Stitch Leather Vest"
metadata/station_required = "lyra_herb_shed"
metadata/station_tier_min = 2
metadata/inputs = [
    {"item_id": "leather_strip", "qty": 8},
    {"item_id": "hemp_cord", "qty": 2},
    {"item_id": "bone_needle", "qty": 1}
]
metadata/output = {"item_id": "leather", "qty": 1}
metadata/time_seconds = 24
metadata/fuel_cost = 0
metadata/unlock_condition = "npc_taught"
metadata/unlock_npc = "herbalist_lyra"
metadata/unlock_hint = "Cure four wolf-pelts. Lyra will lay the pattern out on the herb-shed floor."
metadata/failure_behavior = "none"
metadata/category = "cured_hide"
metadata/teach_voice = "Lyra, pinching a seam: 'Stitches inside, pelt outside. The world doesn't need to see how the work is held.'"
