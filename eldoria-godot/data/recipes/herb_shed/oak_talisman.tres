    {"item_id": "whisperwood_oak_disc", "qty": 1},
    {"item_id": "herb_marshmint", "qty": 2},
    {"item_id": "hemp_cord", "qty": 1}
]
metadata/output = {"item_id": "talisman_oak", "qty": 1}
