[gd_resource type="Resource" format=3]

; Recipe — Carve Oak Talisman
; Lore: items_flavor.json talisman_oak — "Lyra harvested the wood with her hands in the leaf-mould
;   and apologized aloud to Thiar the Stag before she touched it. Strung on a cord she dyed in marshmint water."
; OUTPUT exists: talisman_oak
; # NEEDS:item:whisperwood_oak_disc, herb_marshmint, hemp_cord

[resource]
resource_name = "Carve Oak Talisman"
metadata/schema = "recipes/_schema_v1"
metadata/id = "herbshed_oak_talisman"
