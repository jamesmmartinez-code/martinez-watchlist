[gd_resource type="Resource" load_steps=1 format=3]
[resource]
metadata/_kind = "death_message"
metadata/_data = """
{
  "id": "whispers_from_eldoria",
  "messages": [
    {
      "trigger": "fall_damage",
      "text": "Whoops, time to rest at the wayshrine!",
      "mood": "playful"
    },
    {
      "trigger": "enemy_defeat",
      "text": "The campfire's warm glow awaits – wake refreshed!",
      "mood": "gentle"
    },
    {
      "trigger": "kill_zone",
      "text": "Don't worry, hero! You'll bounce back like a sunflower!",
      "mood": "encouraging"
    },
    {
      "trigger": "drowning",
      "text": "Dry land and fresh air are just a dream away!",
      "mood": "playful"
    },
    {
      "trigger": "fall_damage",
      "text": "Oops, looks like you need a hero-sized nap!",
      "mood": "playful"
    }
  ]
}
"""
