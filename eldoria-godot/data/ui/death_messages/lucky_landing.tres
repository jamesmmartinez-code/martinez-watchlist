metadata/_kind = "death_message"
metadata/_data = """
{
  "id": "lucky_landing",
  "messages": [
    {
      "trigger": "fall_damage|enemy_defeat|kill_zone|drowning",
      "text": "Whoops, looks like I need a little nap by the wayshrine!",
      "mood": "gentle"
    }
  ]
}
"""
