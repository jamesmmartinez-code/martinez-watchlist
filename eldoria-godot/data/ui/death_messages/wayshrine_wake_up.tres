metadata/_kind = "death_message"
metadata/_data = """
{
  "id": "wayshrine_wake_up",
  "messages": [
    {
      "trigger": "fall_damage|enemy_defeat|kill_zone|drowning",
      "text": "Ouch! Time to rest at the wayshrine",
      "mood": "playful"
    }
  ]
}
"""
