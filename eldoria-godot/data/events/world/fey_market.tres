metadata/data = {
"id": "fey_market",
"name": "The Fey Market",
"category": "world",
"region": "whisperwood",
"trigger": {
  "kind": "random_pool",
  "weight": 1,
  "cooldown_hours": 720,
  "world_state_min_progress": 0.3,
  "max_per_year": 2,
  "only_at_time_of_day": "dusk",
  "must_be_alone": true
},
"duration_hours": 1.5,
"participants": ["fey_merchant_offstage"],
"setup": "A glade in the Whisperwood the player has crossed before. This evening it is full of paper lanterns and a small canvas-roofed stall. The merchant cannot be drawn clearly; their face is always half-turned. They speak Common with old constructions.",
"mechanics": [
  {"id": "fey_special_vendor", "kind": "special_vendor", "vendor": "fey_merchant_offstage", "stock": ["bottled_starlight", "memory_of_a_summer", "pressed_question_mark", "compass_that_points_to_what_you_have_lost"], "currency": "memories", "note": "PX: the *currency* here is a player offering — the player must give up one of: a quest-completed flag (resets it), a codex page (returns to undiscovered), or a renown point. The fey trade in returns, not coins."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "harp_distant_no_drums", "lantern_count_glade": 24, "fog_glow_mult": 2.0, "fox_fire_density_mult": 5.0}
],
"rewards": {
  "participation": {"renown": 1, "items": []},
  "trade_made": {"renown": 0, "items_random_from_stock": 1, "lore_unlock": "fey_market_canon", "note": "Trade is irreversible. Codex/quest reset is real."},
  "miss": {"renown": 0, "morning_after_line": "you_did_not_see_what_was_in_the_glade"}
},
"hooks": {
  "child_safety_check": "Player must be level 8+ for this event to fire — below that, the trade-cost is incomprehensible. Hard-gated.",
  "caught": "First time the player witnesses the fey market, codex fragment *The Glade That Was Not There* is queued for Lorekeeper. Mark with `# LORE_GAP: Fey Market canon awaits Lorekeeper.`",
  "two_player_invalid": "If both Owen and Alden are present, the merchants stall is empty. The lanterns are still up. The merchant is *not there.* This is canon: the Stag-Court is a courtesy to the lone walker. Sets brothers_saw_empty_glade = true (small wholesome flag)."
},
"lore_anchor": "world.md → Three Crowns → Antler Crown; stag_courts_courtesy.md → fey-trap softening, the Court is glad when mortals say no.",
"banned": ["coercion_to_buy", "permanent_player_stat_loss", "irreversible_character_changes", "anything_that_feels_predatory_to_a_kid_player"],
"audio_brief": "A single harp, far away. A wind chime that rings without wind. No voice for the merchant — they speak in subtitles only, in a serif blackletter font (UnifrakturMaguntia), one line at a time.",
"px_team_notes": "The trade-cost mechanic (sacrifice a flag) is FLAGGED. PX should design this carefully. Suggested UX: clear preview of what the player gives up; double-confirm; a \"step away from the stall\" option that the merchant never refuses."
}
