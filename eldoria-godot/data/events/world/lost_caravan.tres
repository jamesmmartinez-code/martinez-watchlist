[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "lost_caravan",
"name": "Maras Caravan Did Not Arrive",
"category": "world",
"region": "briarwood",
"trigger": {
  "kind": "world_state",
  "condition": "moon_in [Greenshield, Sunpetal, Reapmoon, Smokerise] AND mara_at_briarwood AND days_since_last_caravan_event_gt_30",
  "max_per_year": 3
},
"duration_hours": 12,
"participants": ["mara_merchant", "stablemaster_roan", "trainer_hala"],
"setup": "Maras monthly supply caravan from the southern smoke-cities is two days late. Mara is at the village entrance, hand on her satchel, watching the south road. Roan saddles a horse without being asked.",
"mechanics": [
  {"id": "search_quest", "kind": "minigame_id", "label": "Ride the south road with Roan", "flag_for": "px_team", "note": "A small ride-out quest. Encounter on the road: bandits OR a broken wheel OR an injured horse. Branching outcome based on what the player chooses to help with first."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "uneasy_strings_low", "mara_idle_animation_override": "mara_paces_at_entrance", "village_general_chatter_volume_mult": 0.5}
],
"rewards": {
  "participation": {"renown": 1, "items": []},
  "caravan_recovered": {"renown": 8, "items": ["mara_letter_unopened", "southern_silk_bolt", "salt_block"], "lore_unlock": "mara_letter_canon"},
  "caravan_lost": {"renown": 4, "items": ["surviving_lantern_keepsake"], "lore_unlock": "caravan_was_lost_but_not_for_nothing", "note": "Even a failed recovery yields lore. The driver, if rescuable, is named — Talen — and is canon thereafter as a recurring offstage NPC."},
  "miss": {"renown": 0, "morning_after_line": "you_did_not_ride_with_roan"}
},
"hooks": {
  "missed": "Mara: \"Its alright, traveler. Roan went. He came back tired. The road is long and not all of it is friendly.\"",
  "caught_recovered": "If `mara_letter_unopened` is recovered, it appears in the players inventory. The letter is addressed to Elder Maeve. If the player reads it, a Maeve-quest queue triggers next session. If the player gives it to Maeve unopened, Maeve says: \"Thank you, traveler. I will read it when the kettle is on.\" Sets npc_flag mara_letter_delivered = true. The player never sees the contents. (Lorekeeper-flagged: Aelis backstory hook per elder_maeve.md.)",
  "kid_specific": "Owen (race car / speed-themed) gets a special line from Roan on the ride: \"Speed gets you there. Care gets you back. Need both.\" Sets owen_lore_care_and_speed = true."
},
"lore_anchor": "world.md → Iron Crown smoke-cities; elder_maeve.md → Aelis is mentioned only and may surface later through Maras unopened letter.",
"banned": ["mara_dies", "caravan_total_loss_with_no_lore", "kid_player_witnessing_violent_caravan_aftermath"],
"audio_brief": "Low strings. A horse breathing hard at the village entrance. No music during the ride-out itself — only the road.",
"px_team_notes": "The branching encounter (bandits/wheel/horse) is FLAGGED. The encounter outcomes affect what items are recovered; design must allow all three branches to succeed and yield meaningful lore. Bandit encounter must use existing bandit asset, not invent new ones."
}
