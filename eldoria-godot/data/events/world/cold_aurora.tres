[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "cold_aurora",
"name": "The Cold Aurora",
"category": "world",
"region": "all",
"trigger": {
  "kind": "random_pool",
  "weight": 1,
  "cooldown_hours": 480,
  "world_state_min_progress": 0.4,
  "max_per_year": 3,
  "only_at_time_of_day": "deep_night",
  "moon_filter": ["Wolfwake", "Longnight", "Foxthaw"]
},
"duration_hours": 2.5,
"participants": ["elder_maeve", "herbalist_lyra"],
"setup": "A cold green-blue aurora ripples above the mountain ring. Visible from anywhere outdoors. Maeve, who never goes out at night, is on her stoop watching. Lyra is at the edge of the herb-garden. Neither calls the player over. They will speak if approached.",
"mechanics": [
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "low_drone_no_melody", "sky_aurora_density": 1.0, "stars_visibility_mult": 0.6, "wind_chill_mult": 1.3, "torch_flicker_rate_mult": 1.5, "every_lantern_in_world_dimmed_pct": 30},
  {"id": "maeve_stoop_dialog", "kind": "modified_drop_table", "table": "elder_maeve_dialog_pool", "added": ["aurora_line_1", "aurora_line_2", "aurora_line_3"], "note": "Three rotating lines. Each one is a quiet reference to the Pale Wyrm's dreaming. Lore-anchored, not invented."},
  {"id": "lyra_garden_dialog", "kind": "modified_drop_table", "table": "herbalist_lyra_dialog_pool", "added": ["aurora_lyra_1"], "note": "One line: she says the herbs that flowered tonight will not flower again this year. She does not seem upset."},
  {"id": "frost_blade_proc", "kind": "modified_drop_table", "table": "frost_marked_blade_proc", "added_chance_pct": 100, "note": "Any player carrying smith_edda's frost-marked blade sees its glyph pulse blue for the duration. Cosmetic. Does not affect stats. Lore-anchored to Pale Wyrm dreaming pushing frost up."}
],
"rewards": {
  "participation": {"renown": 1, "items": [], "note": "Just being outdoors when it happens counts."},
  "approach_maeve": {"renown": 2, "items": ["maeve_aurora_sketch"], "lore_unlock": "aurora_witnessed"},
  "approach_lyra": {"renown": 2, "items": ["lyra_aurora_pressed_flower"], "lore_unlock": "herb_that_will_not_bloom_again"},
  "miss": {"renown": 0, "morning_after_line": "you_slept_through_the_aurora"}
},
"hooks": {
  "missed": "Bram next morning: \"You missed the sky last night. Thought I'd dreamed it. Maeve was on her stoop the whole time.\" Sets npc_flag missed_a_cold_aurora = true.",
  "caught": "Sets player_flag saw_a_cold_aurora += 1. First time triggers codex fragment *The Wyrm Dreams Cold* for Lorekeeper. # LORE_GAP: full text awaits Lorekeeper.",
  "two_player_caught": "If both Owen and Alden are outdoors during the event, the aurora intensifies for them by 1.2× (cosmetic). Sets brothers_saw_aurora = true. Mara the next morning sells a single linked-cord bracelet — discounted, the only way to get the *aurora-thread* cosmetic.",
  "kid_specific": "No fear-state. Aurora is awe, not dread — Maeve's tone steadies the children watching."
},
"lore_anchor": "world.md → The Sundering → The Pale Wyrm has not died — it sleeps somewhere deep, and its dreaming pushes frost up through certain blades.",
"banned": ["combat_during_event", "any_aggressive_mob_aggro", "loud_music_overlay", "tutorial_text_during_aurora", "ui_objective_marker"],
"audio_brief": "A long sub-bass drone, almost felt rather than heard. No melody. No drums. Player's footsteps muted by 40% for the duration. Wind softens. The aurora is silent in the world but the audio mix tells you the world is holding its breath.",
"px_team_notes": "The aurora shader is FLAGGED — likely a sky dome overlay with a green-blue gradient and noise-driven warp. Density param drives intensity. Two-player intensity bump should be subtle, not flashy. Check kid-fear floor — no jump scares, no sudden audio cues."
}
