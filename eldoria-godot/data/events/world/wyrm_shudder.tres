[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "wyrm_shudder",
"name": "The Pale Wyrm Shudders",
"category": "world",
"region": "all",
"trigger": {
  "kind": "random_pool",
  "weight": 3,
  "cooldown_hours": 168,
  "world_state_min_progress": 0.1,
  "max_per_year": 4
},
"duration_hours": 0.05,
"participants": [],
"setup": "A 3-second tremor. Briarwood lanterns sway. Frost-marked blades go cold for one heartbeat. The wolves in the Whisperwood fall silent for a full minute after.",
"mechanics": [
  {"id": "tremor_camera_shake", "kind": "ambient_change", "camera_shake_amplitude": 0.2, "duration_s": 3.0, "lantern_sway_mult": 5.0, "mug_clink_count": 4},
  {"id": "frost_blade_proc", "kind": "ambient_change", "frost_marked_weapons_glow_blue_for_s": 6.0, "note": "Visible only on weapons forged at Eddas anvil with the *haethe* mark."},
  {"id": "wolf_silence", "kind": "modified_drop_table", "table": "whisperwood_ambient_audio", "removed_for_s": 60, "removed": ["wolf_howl", "wolf_growl"]}
],
"rewards": {
  "no_reward": true,
  "participation_lore": "All NPCs near the player will have one variant line for the next 5 minutes. Maeve: \"Ah. He turns in his sleep.\" Edda: \"Forge held. Floor cracked.\" Lyra: \"The herbs leaned south.\""
},
"hooks": {
  "kid_specific": "Alden (frog kid) NPC variant: a small frog in the village pond surfaces and looks at the player. Holds eye contact for 4 seconds. Submerges. Sets alden_lore_frog_witness = true if both player slots are present.",
  "caught": "First time the player experiences this event, an unlock fires: codex stub *The Pale Wyrms Sleep* is created and added to the Codex panel as a stub fragment. Lorekeeper agent will fill it in a future run. Mark with `# LORE_GAP: Pale Wyrm Sleep canon awaits Lorekeeper.`",
  "missed": "Player sleeping or in menu when the event fires gets the morning-after line from Bram only: \"Sky shook. Mug fell. You missed it.\" No mechanical penalty."
},
"lore_anchor": "world.md → Sundering → \"its dreaming pushes frost up through certain blades\"; smith_edda.md → frost-marked sabers.",
"banned": ["actual_damage_from_tremor", "broken_player_buildings", "loss_of_items_or_gold"],
"audio_brief": "Sub-bass roll, 3 seconds. No melody. Then 60 seconds of intentional silence in the Whisperwood ambient bus.",
"px_team_notes": "Camera shake amplitude must be tunable. Some players (motion-sensitive) need this to be skippable via accessibility setting. Falls back to a 1.0× lantern-sway-only variant if motion-reduce is on."
}
