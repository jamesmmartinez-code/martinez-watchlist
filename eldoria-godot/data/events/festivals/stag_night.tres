[resource]
metadata/data = {
"id": "stag_night",
"name": "Stag-Night",
"category": "festival",
"region": "whisperwood",
"trigger": {
  "kind": "calendar",
  "moon": "Emberfall",
  "day": 21,
  "time_of_day": "dusk_to_midnight"
},
"duration_hours": 6,
"repeats_yearly": true,
"participants": ["stablemaster_roan", "trainer_hala", "village_hunters", "thiars_stone_shrine"],
"setup": "The first kill of Emberfall is laid at Thiar the Stags shrine on the forest-line. The hunters eat the second. Roan leads the procession; Hala walks at the rear, sword sheathed.",
"mechanics": [
  {"id": "shrine_offering", "kind": "minigame_id", "label": "Lay an offering at Thiars shrine", "flag_for": "px_team", "note": "Player offers one item — accepted: dire_wolf_pelt, antler_fragment, fresh_bread, a written name (no quest item required). Refused: gold, weapons. Roan judges silently."},
  {"id": "hunters_camp", "kind": "special_vendor", "vendor": "stablemaster_roan", "stock": ["hunters_jerky", "wax_thread", "antler_carved_button"], "only_during_event": true, "note": "Roan rarely sells. This is the one night a year."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "stag_horn_low_drum", "fog_density_mult": 1.5, "lantern_color": "amber_warm", "owl_calls_density_mult": 3.0, "wolves_distant_only": true},
  {"id": "stag_bow_apparition", "kind": "modified_drop_table", "table": "whisperwood_rare", "added_chance_pct": 5, "added": ["thiars_horn_carved"], "note": "Once per event. The horn is canonical proof-of-attendance, no stats."}
],
"rewards": {
  "participation": {"renown": 2, "items": ["antler_fragment"]},
  "offer_accepted_by_roan": {"renown": 5, "items": ["hunters_jerky_x3"], "lore_unlock": "thiars_mercy_owed_to_prey"},
  "miss": {"renown": 0, "morning_after_line": "you_missed_stag_night"}
},
"hooks": {
  "missed": "Roan says (no eye contact): \"Forest was quiet. We managed.\" Sets npc_flag roan_distant = true for one Whisperwood quest cycle.",
  "caught": "Player whose offering is accepted by Roan unlocks an out-of-event line from Hala: \"Mercy owed to prey is mercy owed to enemies. Remember it.\" — sets training_unlock_compassion_form = true (Halas sword-form library expands by 1).",
  "fey_warning": "Stag-Night is on the *Whisperwood side* of the forest-line. Player wandering more than 30m past the shrine on this evening triggers a fox-fire scatter-spawn and a single Old Faerie whispered phrase: *vael-i-thirren*. No combat. No reward. Only the warning. (Lorekeeper-flagged: this is the only night per year the Stag-Court reaches into player-walkable space.)"
},
"lore_anchor": "world.md → Wild Pantheon → Thiar; stag_courts_courtesy.md → Foxthaw paired with Honeysong as rites the village must keep — Stag-Night is the villages reciprocal toward Thiar.",
"banned": ["fireworks", "torches_open_flame_in_forest", "loud_music", "shouting"],
"audio_brief": "One stag-horn at procession start. Then silence for ninety seconds. Then a low drum, slow as a deer at rest. No singing. No flutes.",
"px_team_notes": "Shrine offering minigame is FLAGGED. The 30m-past-shrine fox-fire trigger is canon — please honor even if the rest of the event is stubbed. The single whispered phrase (*vael-i-thirren*) should not be subtitled."
}
