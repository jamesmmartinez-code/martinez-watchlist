[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "thirres_vigil",
"name": "Thirres Vigil",
"category": "festival",
"region": "crystal_caves",
"trigger": {
  "kind": "calendar",
  "moon": "Foxthaw",
  "day": 11,
  "time_of_day": "dusk_to_dawn"
},
"duration_hours": 12,
"repeats_yearly": true,
"participants": ["herbalist_lyra"],
"setup": "Foxthaws eleventh evening — the same evening named in the Stag-Court fragment. Lyra walks alone to the lip of the Crystal Cave under-stream and sets one candle. She does not speak the whole time. The village does not know she goes.",
"mechanics": [
  {"id": "follow_lyra", "kind": "minigame_id", "label": "Follow Lyra (silently)", "flag_for": "px_team", "note": "Player who happens to be near Lyras hut at dusk on this date may follow her. Walking pace only. Speaking aloud (any chat command) cancels event with no penalty."},
  {"id": "candle_at_understream", "kind": "minigame_id", "label": "Light a second candle at the lip", "flag_for": "px_team", "note": "If player has read the stag_courts_courtesy fragment, a second candle-spot becomes interactable. Lighting it does nothing visible. The cave-air smells of cold iron for the next 30 seconds."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "single_flute_no_chord", "cave_blue_glow_mult": 1.2, "drip_echo_density_mult": 0.5, "wind_above_caves_silenced": true}
],
"rewards": {
  "participation": {"renown": 0, "items": [], "note": "No reward. The vigil is the reward."},
  "follow_silently_to_dawn": {"renown": 4, "lore_unlock": "lyra_knows_the_courtesy", "note": "Lyra never tells the player she knew they followed."},
  "miss": {"renown": 0, "no_morning_after": true, "note": "Lyra would not mention it. The village does not mark this date."}
},
"hooks": {
  "caught": "If player follows silently and has read the fragment, Lyra at sunrise says exactly one line: \"Velhain-tor, traveler.\" Then walks past. Sets npc_flag lyra_acknowledged_courtesy = true. This is the only place outside the codex that the phrase is spoken aloud.",
  "no_announce": "The morning Briarwood toast does not announce this event. The calendar UI does not flag it. The player either knows or does not. (Lorekeeper-flagged: this is by design.)"
},
"lore_anchor": "stag_courts_courtesy.md → Foxthaw 11th + Crystal Caves *thirre*; world.md → Crystal Caves are the wound itself.",
"banned": ["any_combat_in_caves_during_event", "vendors", "ambient_pop_music", "subtitled_voiceover", "ui_announcements"],
"audio_brief": "ONE flute note at the moment Lyra lights her candle. Otherwise: cave drip, slowed. No music.",
"px_team_notes": "This event is intentionally hidden. PX must NOT add it to a calendar UI, a quest-log entry, or a notification. The discoverability path is: read the fragment, be near Lyra at dusk on Foxthaw 11. Anything more breaks the canon."
}
