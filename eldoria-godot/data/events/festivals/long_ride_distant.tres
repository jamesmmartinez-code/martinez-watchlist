[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "long_ride_distant",
"name": "The Long Ride (distant)",
"category": "festival",
"region": "mountain_ring",
"trigger": {
  "kind": "calendar",
  "moon": "Greenshield",
  "day": 1,
  "time_of_day": "all_day"
},
"duration_hours": 24,
"repeats_yearly": true,
"participants": ["stablemaster_roan", "village_horses", "stone_crown_clans_offstage"],
"setup": "On the first of Greenshield the Stone Crown clans of the High Steppe begin the Long Ride — the years seven-day endurance race that names whoever wears the braided horsehair circlet. Briarwood cannot see it. Briarwood can hear it. From the mountain-side pasture the player hears, on the wind, very faint horns.",
"mechanics": [
  {"id": "listen_at_the_pasture", "kind": "minigame_id", "label": "Listen at the mountain-side pasture", "flag_for": "px_team", "note": "Player who stands still in the pasture for 60 seconds during the event hears the horn. No subtitle. Sets npc_flag heard_the_long_ride = true."},
  {"id": "roan_ambient_change", "kind": "ambient_change", "music_track": "no_change_but_roan_whittles_a_circlet", "roan_idle_animation_override": "roan_whittles_horsehair_circlet", "note": "Roan, on this day only, sits on the pasture fence with horsehair in his hands. Children who approach see the half-finished circlet. Roan does not explain it."}
],
"rewards": {
  "participation": {"renown": 0, "items": []},
  "hear_the_horn": {"renown": 1, "items": ["pressed_steppe_grass_keepsake"], "lore_unlock": "long_ride_canon_for_player"},
  "ask_roan_about_it": {"renown": 2, "lore_unlock": "roan_was_a_rider_partial", "note": "Roan answers in three sentences and stops. He does not say more on any day of any year."},
  "miss": {"renown": 0, "morning_after_line": "none"}
},
"hooks": {
  "caught_and_asked_roan": "Roan: \"Heard the horn, did you. I knew a man who rode it nineteen times. Won twice.\" Long pause. \"Hes past it now.\" — sets roan_brother_lore_partial = true. The brothers name is never spoken; the canon stays open per elder_maeve.md (Cailen) and is intentionally not pinned.",
  "kid_specific": "Owen (race car kid) approaching Roan during this event triggers a special Roan line: \"Speed isnt the prize, lad. Lasting is the prize. Speed is what you bring to the lasting.\" — sets owen_lore_speed_lasting = true."
},
"lore_anchor": "world.md → Three Crowns → Stone Crown braided-horsehair circlet; world.md → Calendar → Greenshield; elder_maeve.md → Cailen left for the Stone Crown (intentionally NOT confirmed as the brother Roan knew).",
"banned": ["actual_visible_riders_in_briarwood", "named_steppe_npcs_appearing", "any_iron_crown_or_antler_crown_inserts_today"],
"audio_brief": "One horn, three notes, very faint, on a 4-minute loop. Otherwise the day is normal Greenshield-pasture ambient.",
"px_team_notes": "The horn must be quiet enough that a player not standing still in the pasture will not notice. This is a discoverability gate, not a UX failure."
}
