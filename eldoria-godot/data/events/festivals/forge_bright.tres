[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "forge_bright",
"name": "Forge-Bright",
"category": "festival",
"region": "briarwood",
"trigger": {
  "kind": "calendar",
  "moon": "Reapmoon",
  "day": 7,
  "time_of_day": "dawn_to_noon"
},
"duration_hours": 6,
"repeats_yearly": true,
"participants": ["smith_edda", "innkeeper_bram", "trainer_hala", "stablemaster_roan", "village_apprentices"],
"setup": "Brigid the Forge-Mothers morning. Edda lights the great forge before sunrise; the chimney smoke is the village clock. Children bring iron scraps to the anvil and Edda welds a small charm for each.",
"mechanics": [
  {"id": "scrap_to_charm", "kind": "minigame_id", "label": "Bring iron scrap to the anvil", "flag_for": "px_team", "note": "Player gives 3 scrap_iron items to Edda; Edda forges a charm with random shape (acorn, leaf, stag, hammer, fox). Charm is wearable, +1 renown when seen on player."},
  {"id": "edda_special_stock", "kind": "special_vendor", "vendor": "smith_edda", "stock": ["frost_marked_blade", "forge_bright_pin", "hammered_brass_buckle"], "discount_pct": 20, "only_during_event": true, "note": "Frost-marked blade is the canonical Pale-Wyrm-dreaming reference (world.md). Stock 1 only."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "forge_drums_anvil", "anvil_clang_loop": true, "smoke_plume_height_mult": 2.0, "sparks_density_mult": 4.0}
],
"rewards": {
  "participation": {"renown": 2, "items": ["forge_bright_pin"]},
  "bring_three_scraps": {"renown": 4, "items": ["edda_forged_charm_random"]},
  "buy_frost_blade": {"renown": 6, "items": ["frost_marked_saber"], "lore_unlock": "frost_smiths_know_what_they_name"},
  "miss": {"renown": 0, "morning_after_line": "you_missed_forge_bright"}
},
"hooks": {
  "missed": "Edda says: \"Forge ran cold without you. Brigid noticed; I did not.\" Dry. No grudge.",
  "caught": "If player brings scraps and stays through Eddas noon hammer-pause, Edda speaks the line: \"Haethe. The hand that holds the hammer is the hand that holds the line.\" Unlocks edda_blessing flag — next weapon Edda forges has a -10% durability decay.",
  "kid_specific": "If both Owen (race-car / McLaren orange) and Alden (frog / mint) bring a scrap, Edda forges a paired charm — orange and mint enamel — and gives one to each. Memory-anchor for the brothers."
},
"lore_anchor": "world.md → Wild Pantheon → Brigid the Forge-Mother; smith_edda.md → haethe word + Halsa anvil-mark.",
"banned": ["forge_extinguished_during_event", "rain_inside_smithy", "edda_off_duty"],
"audio_brief": "Real anvil. Real bellows. A drum somewhere up in Eddas loft, slow heartbeat tempo. No flute today — Edda doesnt hold with flutes at the forge.",
"px_team_notes": "Scrap-to-charm minigame is FLAGGED. Player should not be able to bring more than 3 scraps per event (Edda will refuse). The frost-marked blade is a one-per-year stock — if the player buys it, Edda doesnt restock."
}
