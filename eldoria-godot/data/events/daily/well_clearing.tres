[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "well_clearing",
"name": "Clear the Village Well",
"category": "daily",
"region": "briarwood",
"giver": "village_well",
"objective": "Clear leaves and twigs from the well rim. (Small careful task — the well is a Sundering-old shaft, no rough handling.)",
"duration_hours": 4,
"rewards": {"renown": 1, "items": ["coin_old_dropped_in_well"], "coin": 2},
"variant_lines": {
  "accept": "Maeve, passing: \"Vellum is patient. The well most of all.\"",
  "complete": "Maeve: \"Cleaner than the day I was a girl. *small nod*\"",
  "miss": "The wells leaves blow off in the night wind. No penalty."
},
"hooks": {
  "rare_drop": "1% chance per clearing: a small carved acorn, dropped into the well decades ago, surfaces in the rope-bucket. Hands the player a `maeve_acorn_carved` (the same item Maeve would give for completing her main quest). Maeve pretends not to notice."
}
}
