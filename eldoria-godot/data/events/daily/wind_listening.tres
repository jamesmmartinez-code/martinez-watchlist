[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "wind_listening",
"name": "Sit on the Spine, Listen",
"category": "daily",
"region": "mountain_ring",
"giver": "trainer_hala",
"objective": "Walk to the flat ledge above Hala's training-yard. Sit. Stay still. Three full minutes. Tell Hala one sound you heard that wasn't wind.",
"trigger": {"kind": "random_pool", "weight": 2, "cooldown_hours": 96, "only_at_time_of_day": "afternoon"},
"duration_hours": 6,
"participants": ["trainer_hala"],
"mechanics": [
  {"id": "stillness_check", "kind": "minigame_id", "label": "Sit still on the ledge", "flag_for": "px_team", "note": "Player presses Sit. Camera slow-pulls back. Three real minutes of in-game time (not skippable, but if the player moves before timer the quest does not fail — Hala just says no sound is named tonight). Audio mix swaps to layered ambient track."},
  {"id": "ambient_change", "kind": "ambient_change", "music_track": "wind_layered_with_far_voice", "ambient_birds_density_mult": 0.3, "ambient_distant_horse_chance_pct": 12, "ambient_distant_axe_chance_pct": 8, "ambient_distant_singing_chance_pct": 4}
],
"rewards": {
  "complete": {"renown": 2, "items": [], "coin": 0, "note": "Reward is the codex-line Hala unlocks. No item."},
  "miss": {"renown": 0, "morning_after_line": "hala_no_remark"}
},
"variant_lines": {
  "accept": "Hala, looking past you: \"Up the ledge. Sit. Three breaths times sixty. Then come back and tell me one sound that wasn't wind.\"",
  "complete_horse": "Hala: \"A horse is the kindest thing the mountain says. Stone Crown rider, two ridges over. They are not coming here.\"",
  "complete_axe": "Hala: \"An axe. Wood, not iron. Charcoal-burner on the south slope. He is fine. He is *always* fine.\"",
  "complete_singing": "Hala goes very still. \"Then you have heard what I hoped you had not. Do not ask me what it was. Do not ask again tonight.\" Sets npc_flag hala_heard_the_singing = true.",
  "complete_other": "Hala: \"That is a wind sound. Sit longer next time. The mountain rewards patience, not cleverness.\"",
  "miss": "Hala does not look up. The wind comes down the slope cold."
},
"hooks": {
  "missed": "No state change.",
  "caught": "Codex fragment *Sounds the Mountain Keeps* unlocks one line per completion (rotating from the four reply variants).",
  "kid_specific": "If both players complete and report different sounds, Hala laughs once — the one time per game-year she does. Sets brothers_made_hala_laugh = true (cosmetic morning-after line)."
},
"lore_anchor": "world.md → Tongues → Stone-Tongue (each word a small oath); Hala's NPC backstory mentions she crossed Whisperwood alone in Wolfwake.",
"banned": ["combat_on_ledge", "skip_button_for_sit_timer", "background_music_during_sit"],
"audio_brief": "The point IS the audio. PX should layer 4 tracks at very low volume — one of them is a *very quiet* fey choir. The choir track plays only on the 4% roll. No drums.",
"px_team_notes": "The four ambient roll outcomes are FLAGGED. Distant horse, distant axe, distant singing (rare), and silence (default). Hala has a different reply for each. The singing-line is a story hook the Lorekeeper is queued to expand. # LORE_GAP: what the mountain sings."
}
