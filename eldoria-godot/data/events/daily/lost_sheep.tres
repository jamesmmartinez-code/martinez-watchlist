[resource]
metadata/data = {
"id": "lost_sheep",
"name": "Find the Holt Sheep",
"category": "daily",
"region": "briarwood",
"giver": "village_holt_family",
"objective": "Three sheep wandered off the pasture. Find them and walk them home. (No combat — sheep follow on a slow walk-pace.)",
"duration_hours": 12,
"rewards": {"renown": 2, "items": ["holt_thanks_wool_skein"], "coin": 5},
"variant_lines": {
  "accept": "Young Holt boy at the well: \"Three of them. Brindle, white-foot, and Mabel. Mabel is the one who finds the trouble.\"",
  "complete": "Holt boy: \"Mam will give you wool. She always does.\"",
  "miss": "Holt boy looks down. The sheep come back on their own at dusk. No penalty — just a quieter dinner at the Holts."
}
}
