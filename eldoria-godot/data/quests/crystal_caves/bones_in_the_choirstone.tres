[gd_resource type="Resource" format=3]

; ──────────────────────────────────────────────────────────────────────
;  Quest:   Bones in the Choirstone
;  Id:      bones_in_the_choirstone
;  Region:  crystal_caves   Act: 2   Level band: 6-8
;  Giver:   Elder Maeve (Briarwood — at the Vigil shelf in her cottage)
;  Voice:   THEME §7 — warm gravitas, child-safe; Maeve never rushes.
;
;  Canon anchors used:
;    - data/codex/stag_courts_courtesy.md :: Crystal Caves are a thirre;
;        the under-stream lip is the canonical fragment site; cave-air
;        smells of cold iron. "Tend the Vigil candles. Tend Erris's
;        lanterns. Tend the herb beds." The Vigil candles are Maeve's
;        canonical responsibility.
;    - data/codex/steppe_riders_refusal.md :: confirms the Caves are a
;        thirre held jointly — Vellum's wound and the Court's listening
;        post both. The cave hums at the same low pitch as Vellum the
;        Patient Stone.
;    - data/items_flavor.json :: guardian_core ("hums at the same low
;        pitch as Vellum"), crystal_shard ("faintly humming on cold
;        mornings the way Vellum the Patient Stone is said to hum on
;        the deepest Longnight").
;    - data/spawn_tables/crystal_caves.tres :: Risen Bone Soldiers
;        (skeleton, level 6, tier 1) spawn here in pop_cap 8 day/night.
;        Mechanically supports a quiet-them-down kill quest in band.
;    - data/creatures/skeleton.tres :: display_name "Risen Bone Soldier",
;        family undead, level 6 — exactly the right level for the band.
;    - lore/world.md :: Longnight (the deepest winter, when Vellum hums)
;        and Vigil candles canon. (per author note in stag_courts_courtesy
;        and the items_flavor entries.)
;
;  Authoring note: the second .tres-format quest in the project. Mirrors
;  the grammar of shards_for_mara.tres (legacy fields populated for the
;  current single-action runtime, richer stages[]/prereqs[] for the
;  future runtime described in QUEST_GRAMMAR.md). Dialogue placeheld
;  with <<DLG: …>> tokens for lore-keeper. No new lore invented; the
;  cave-hum coupling and the Vigil candles' link to Longnight are both
;  established canon, not a new claim.
;
;  Why this quest, here, now:
;    - Crystal Caves had only 1 .tres quest (shards_for_mara). Skill
;      priority 1 satisfied: region with fewer than 3 quests.
;    - shards_for_mara is a fetch with Mara as giver. This quest is a
;      kill with Maeve as giver — different giver, different kind, same
;      region — gives the player two reasons to be in the Caves and two
;      different village voices to bring news back to.
;    - The Vigil candles are mentioned in *both* codex fragments as one
;      of the three things Briarwood must tend. They have not yet had a
;      gameplay surface. This quest gives them one without intruding on
;      Maeve's silence-canon (no Stag-Court material is touched).
;    - Skeletons are in the Caves' spawn table at level 6 (matches the
;      band exactly). The kill mechanic is shipped (per QUEST_GRAMMAR.md
;      "kind kill — shipped"); no new engine work required for the
;      single-stage execution path.
;
;  NEEDS / LORE_GAP flags raised:
;    # NEEDS:engine:multi_stage_quest_runtime — same flag as the first
;      .tres quest. World.gd runs single-action quests today; the 4-
;      stage shape below requires a stage-pointer on QuestState.
;    # NEEDS:engine:prereq_resolver — same flag as the first .tres
;      quest. `prereqs[]` (quest_completed, world_flag, player_level)
;      needs a single resolver hook before Maeve offers it.
;    # NEEDS:engine:enter_region_trigger — stage 2 expects
;      enter_region(crystal_caves). Area3D regions still not wired.
;    # NEEDS:player_experience:level_band_balance — the skill names
;      pacing/level_bands.md as the source of truth for XP/gold per
;      band; that file does not exist yet. The 250 xp / 200 gold values
;      below are interpolated from shards_for_mara (220/180 at the same
;      band) plus a small kill-vs-fetch danger premium. Player-experience
;      should confirm or correct.
;    # LORE_GAP:lore/regions/ — same flag as the first .tres quest. The
;      per-region brief folder named in the skill spec does not exist
;      yet. Crystal Caves canon is split across data/codex/*.md and
;      lore/world.md. Lore-keeper may consolidate.
;    # NEEDS:dialogue:elder_maeve.json :: vigil_shelf branch — the
;      existing Maeve dialogue file (per OPERATIONS / CHANGES) does
;      not yet have a Vigil-shelf branch. Lore-keeper expands the
;      <<DLG: …>> placeholders below into Maeve's canonical voice.
; ──────────────────────────────────────────────────────────────────────

[resource]
resource_name = "bones_in_the_choirstone"
metadata/schema_version = 1
metadata/quest = {
"id": "bones_in_the_choirstone",
"title": "Bones in the Choirstone",
"region": "crystal_caves",
"act": 2,
"level_band": "6-8",
"hook": "The Vigil candles flicker wrong. Maeve says the cave-drips are keeping time, and bones are marching along. Quiet them before Longnight.",
"actor": "Elder Maeve",
"giver": "Elder Maeve",
"role": "elder",
"motivation": "duty",
"location": "Crystal Caves",
"urgency": "calm",
"kind": "kill",
"target": "skeleton",
"item": "",
"needed": 6,
"title_journal": "Bones in the Choirstone",
"text": "Quiet 6 Risen Bone Soldiers in the Crystal Caves so the Vigil candles can hold their shape before Longnight.",
"prereqs": [
{"kind": "quest_completed", "id": "whisperwood_cleansing"},
{"kind": "world_flag", "id": "crystal_caves_unlocked"},
{"kind": "player_level", "gte": 6}
],
"world_trigger": {"kind": "player_level", "value": 6},
"stages": [
{
"id": "hear_at_vigil_shelf",
"objective": "Hear Maeve at the Vigil shelf in her cottage.",
"location": "Briarwood Village — Elder Maeve's cottage, Vigil shelf",
"completion_trigger": {"kind": "dialogue_accept", "quest_id": "bones_in_the_choirstone"},
"dialogue": "<<DLG:offer — Maeve speaks slowly, never rushes. She names the candles flickering 'wrong' but does not name what 'right' is. She mentions Longnight obliquely — a season the player may have heard of from the Longnight Vigil event. She does not name the Stag-Court. She does not say 'undead.' She says 'bones.' One small line about the cave-drips keeping time so an attentive 9-year-old hears the music underneath. End on the silence Maeve is canonical for — let her stop talking before the player has finished listening.>>"
},
{
"id": "reach_caves_understream",
"objective": "Reach the under-stream lip in the Crystal Caves.",
"location": "Crystal Caves — under-stream lip",
"completion_trigger": {"kind": "enter_region", "region": "crystal_caves"},
"flavor": "The cave-air smells of cold iron — that is the lore-keeper's line; do not contradict. The hum is faint here; the player should hear it before they see anything moving. (Audio agent: same low pitch as Vellum the Patient Stone — see items_flavor :: guardian_core.)"
},
{
"id": "quiet_the_marching_bones",
"objective": "Quiet 6 Risen Bone Soldiers in the cave-halls.",
"location": "Crystal Caves",
"completion_trigger": {"kind": "kills_by_kind", "target": "skeleton", "gte": 6},
"sources": ["skeleton"],
"sources_note": "skeletons are the dominant night spawn (weight 0.65, count 5-8) and a strong day spawn (weight 0.55, count 4-6) per data/spawn_tables/crystal_caves.tres. Six in a normal grind is well-tuned for the level 6-8 band — about one full pop_cap pass.",
"flavor": "The skeletons here are not malicious; they are *out of time.* The lore-keeper word 'quiet' is intentional — Maeve does not say 'kill' and the journal should not either. The player is putting them back to rest. (Combat is mechanically a kill; the language is a quiet.)"
},
{
"id": "return_to_maeve",
"objective": "Return to Maeve at the Vigil shelf.",
"location": "Briarwood Village — Elder Maeve's cottage, Vigil shelf",
"completion_trigger": {"kind": "dialogue_turnin", "quest_id": "bones_in_the_choirstone"},
"dialogue": "<<DLG:turnin — Maeve thanks the player. She does not say what they did; she says 'the candles are steady tonight.' She offers a simple gift — two greater health potions and a coin-purse — passes them across the table, and lights one fresh candle on the shelf. She says one word as she lights it: 'velhain-tor.' She does not translate. (Codex readers will know the word from stag_courts_courtesy. Other players hear it as a small benediction. Maeve has never said it before in the village; the Vigil shelf has earned it.)>>"
}
],
"dialogue_placeholders": {
"offer": "<<DLG: Maeve at the Vigil shelf — calm, slow, child-safe; mentions Longnight obliquely; does not name the Stag-Court or 'undead'; closes on her canonical silence.>>",
"in_progress": "<<DLG: Maeve, on a return visit before completion: 'The candles still listen, traveler. Walk slow.' One sentence. No follow-up.>>",
"turnin": "<<DLG: Maeve accepts the news, lights one fresh candle, says 'velhain-tor' once and does not translate. The whole exchange should take less time than the candle takes to catch.>>",
"decline": "<<DLG: Maeve nods. The candle she was about to light, she does not light. She tips her head and waits. (Maeve never pressures; the candle waits with her.)>>"
},
"rewards": {
"xp": 250,
"gold": 200,
"items": [{"id": "hp_potion_l", "qty": 2}],
"faction_rep": {},
"unlocked_content": ["vigil_candles_steady"]
},
"xp_reward": 250,
"gold_reward": 200,
"reward_item": "hp_potion_l",
"reward_item_qty": 2,
"branches": [],
"fail_conditions": [],
"consequence": {
"world_flag": "vigil_candles_steady",
"npc_flag": ["Elder Maeve", "trusts_player_at_vigil"],
"toast": "🕯️ The Vigil candles are steady tonight."
},
"repeatable": false,
"sniff_test_note": "Hook is 138 chars and lands on three concrete nouns a 9-year-old can picture: candles flickering wrong, drip-water keeping time, marching bones. The objective verb 'quiet' (not 'kill') keeps the warm-gravitas voice through the journal text — even though the mechanic is a kill, the language is a putting-back-to-rest, which is exactly the recoverable-stakes shape THEME §7 asks for. The candle on Maeve's shelf is a visible end-state the player can come back to.",
"voice_notes": "Maeve speaks slowly, never rushes. She does not name the Stag-Court (per stag_courts_courtesy.md author note: she will not, ever). She does not say 'undead' — she says 'bones.' Her single Old-Faerie word at turn-in (velhain-tor) is the one she has never said before in the village; the Vigil shelf is the only place she would say it. Lore-keeper: please preserve this beat exactly when expanding the placeholders.",
"design_intent": "Pairs with shards_for_mara as the Caves' second .tres-format quest. Two givers (Mara, Maeve), two kinds (fetch, kill), two motivations (commerce, vigil). A player who completes both walks out of the Caves with a ring on their finger and a candle steady in the village. The Caves become *useful* to Briarwood, not just dangerous to enter."
}
