[gd_resource type="Resource" format=3]

; ──────────────────────────────────────────────────────────────────────
;  Quest:   Stones for the Southern Jeweler
;  Id:      shards_for_mara
;  Region:  crystal_caves   Act: 2   Level band: 6-8
;  Giver:   Mara the Merchant (Briarwood market stall)
;  Voice:   THEME §7 — warm gravitas, child-safe; Mara never haggles
;
;  Canon anchors used:
;    - data/items_flavor.json :: ring_focus
;        ("Three hands, one ring … shard from the Caves … hammering is
;         Edda's, the setting is Mara's southern jeweler.")
;    - data/codex/stag_courts_courtesy.md :: Caves are a thirre, the
;        cave-air smells of cold iron, the under-stream is canon geometry.
;    - lore/world.md :: Honeysong Eve (Erris's lanterns, midsummer).
;    - data/items_flavor.json :: crystal_shard exists in Items.ITEMS.
;    - scripts/Items.gd :: crystal_elemental drops crystal_shard at w=60
;        (dominant material drop, plenty of source for 5 in a normal grind).
;
;  Authoring note: this is the first .tres-format quest in the project.
;  The grammar in QUEST_GRAMMAR.md (root) is preserved verbatim — all
;  legacy fields (actor/kind/needed/etc.) remain populated so a single-
;  stage runtime can still execute the quest as a fetch. The richer
;  `stages[]` and `prereqs[]` blocks describe the multi-step intent for
;  any future runtime that supports them. Dialogue is placeholdered with
;  <<DLG: …>> tokens for lore-keeper.
;
;  NEEDS / LORE_GAP flags raised:
;    # NEEDS:engine:multi_stage_quest_runtime — World.gd currently runs
;      single-action quests (kill / fetch). The 4-stage shape below
;      requires a stage-pointer field on the player's QuestState.
;    # NEEDS:engine:prereq_resolver — `prereqs[]` (quest_completed,
;      world_flag, player_level) needs a single resolver hook before the
;      quest is offered by Mara.
;    # NEEDS:engine:enter_region_trigger — stage 2 expects an
;      enter_region(crystal_caves) signal; Area3D regions are not yet
;      wired (per QUEST_GRAMMAR.md "explore: reserved").
;    # LORE_GAP:lore/regions/ — the skill names lore/regions/<r>.md as
;      the per-region brief; that folder does not exist yet. For now, the
;      Crystal Caves brief lives split across data/codex/*.md and
;      lore/world.md. Lore-keeper may consolidate.
; ──────────────────────────────────────────────────────────────────────

[resource]
resource_name = "shards_for_mara"
metadata/schema_version = 1
metadata/quest = {
"id": "shards_for_mara",
"title": "Stones for the Southern Jeweler",
"region": "crystal_caves",
"act": 2,
"level_band": "6-8",
"hook": "Mara's coin-pouches jingle short. Her jeweler down south has a wedding to set — three Caves-shards, before the lantern boats sail.",
"actor": "Mara the Merchant",
"giver": "Mara the Merchant",
"role": "shop",
"motivation": "duty",
"location": "Crystal Caves",
"urgency": "calm",
"kind": "fetch",
"item": "crystal_shard",
"target": "crystal_shard",
"needed": 5,
"title_journal": "Stones for the Southern Jeweler",
"text": "Bring 5 Crystal Shards from the Crystal Caves to Mara — for her southern jeweler's wedding commission.",
"prereqs": [
{"kind": "quest_completed", "id": "ears_for_mara"},
{"kind": "world_flag", "id": "crystal_caves_unlocked"},
{"kind": "player_level", "gte": 6}
],
"world_trigger": {"kind": "player_level", "value": 6},
"stages": [
{
"id": "hear_commission",
"objective": "Hear Mara's commission at her market stall.",
"location": "Briarwood Village — Mara's stall",
"completion_trigger": {"kind": "dialogue_accept", "quest_id": "shards_for_mara"},
"dialogue": "<<DLG:offer — Mara, businesslike but warm; mentions her southern jeweler obliquely; the wedding is for someone the player has not met. Drop a single line about the lantern boats so an attentive 9-year-old hears Honeysong Eve underneath.>>"
},
{
"id": "reach_caves",
"objective": "Reach the under-stream in the Crystal Caves.",
"location": "Crystal Caves — under-stream lip",
"completion_trigger": {"kind": "enter_region", "region": "crystal_caves"},
"flavor": "The cave-air smells of cold iron — that is the lore-keeper's line; do not contradict."
},
{
"id": "gather_shards",
"objective": "Gather 5 crystal shards from the cave's elementals.",
"location": "Crystal Caves",
"completion_trigger": {"kind": "inventory_count", "item": "crystal_shard", "gte": 5},
"sources": ["crystal_elemental", "crystal_guardian"],
"sources_note": "crystal_shard drops dominantly from crystal_elemental (Items.gd w=60). 5 shards is roughly an 8-elemental grind on average — well-tuned for the level band."
},
{
"id": "return_to_mara",
"objective": "Return the shards to Mara at her stall.",
"location": "Briarwood Village — Mara's stall",
"completion_trigger": {"kind": "dialogue_turnin", "quest_id": "shards_for_mara"},
"dialogue": "<<DLG:turnin — Mara takes each shard up to the lantern, holds it to the light, says nothing. Then pays in full. Then, almost as an afterthought, slides the sample ring across the counter. 'Three hands, one ring, traveler. Try it on. The village calls that lucky.'>>"
}
],
"dialogue_placeholders": {
"offer": "<<DLG: Mara offers the commission — warm, businesslike, hints at the wedding without naming who is being married. Lantern-boat reference belongs here.>>",
"in_progress": "<<DLG: Mara, on a return visit before completion: reassures, speaks of her jeweler being patient, never haggles>>",
"turnin": "<<DLG: Mara accepts the shards, pays in full, slides the sample ring across the counter. 'Three hands, one ring.' Beat is canonical from items_flavor :: ring_focus.>>",
"decline": "<<DLG: Mara is unbothered. Will hold the offer. Tips her head and finishes the strap she is drawing through a buckle. (Mara never pressures.)>>"
},
"rewards": {
"xp": 220,
"gold": 180,
"items": [{"id": "ring_focus", "qty": 1}],
"faction_rep": {},
"unlocked_content": ["mara_jeweler_supplied"]
},
"xp_reward": 220,
"gold_reward": 180,
"reward_item": "ring_focus",
"reward_item_qty": 1,
"branches": [],
"fail_conditions": [],
"consequence": {
"world_flag": "mara_jeweler_supplied",
"npc_flag": ["Mara the Merchant", "trusts_player_with_glass"],
"toast": "💎 Mara's southern jeweler will be pleased."
},
"repeatable": false,
"sniff_test_note": "Hook is 137 chars and lands on three concrete nouns a 9-year-old can picture: coin-pouches, a wedding, lantern boats. Reward is the canonical scribe's ring (ring_focus) — same item Mara's jeweler made for the village in lore. The story closes its own loop.",
"voice_notes": "Mara never haggles. She tips her head and finishes the strap. Use the items_flavor cadence — no flourishes, no urgency."
}
