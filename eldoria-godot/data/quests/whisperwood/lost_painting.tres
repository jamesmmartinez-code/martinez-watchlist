      "completion_trigger": "defeat:pixie_thief"
    },
    {
      "objective": "Return the painting to Eira",
      "location": "Whisperwood Artist's Guild",
      "completion_trigger": "talk_to_npc:eira"
    }
  ],
  "rewards": {
