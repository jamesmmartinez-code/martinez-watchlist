[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "whisperwood_rumors",
"region_origin": "whisperwood",
"freshness_decay_days_default": 14,
"lines": [
  {"text": "The goblins have a new drum. Bigger than last years. Bigger doesnt mean better; bigger means farther.", "truthiness": "true", "decay_days": 14},
  {"text": "Theres a clearing where the moss grows in a perfect circle. Dont step in. Lyra wont say why.", "truthiness": "true", "decay_days": 30},
  {"text": "On a Foxthaw evening, fox-fire moves with you. Walk slow. Walk steady. Dont run.", "truthiness": "true", "decay_days": 60},
  {"text": "A goblin scout once saluted a hunter and walked away. The hunter remembers. The goblin clan does not.", "truthiness": "partial", "decay_days": 14},
  {"text": "Hala says the trees north of the goblin camp lean east, even on a still day. She watches them. So should you.", "truthiness": "true", "decay_days": 21},
  {"text": "Theres a stag that walks the forest line. White on its left flank. No one has ever seen it twice from the same side.", "truthiness": "partial", "decay_days": 30},
  {"text": "Past the second crystal arch in the caves, the cave-air smells of cold iron. Thats the threshold. Past it is *thirre*.", "truthiness": "true", "decay_days": 60},
  {"text": "An old woodsman swore he saw the Antler Crown in the deep wood. He came home, and never spoke of it. Lived to ninety-one.", "truthiness": "partial", "decay_days": 60},
  {"text": "Goblin Cant has Old Faerie roots. Lyra hears it. The goblins dont know theyre speaking it.", "truthiness": "true", "decay_days": 60},
  {"text": "The wolves are hungrier this Wolfwake. Roan thinks its the goblins driving the deer. The goblins think its the wolves.", "truthiness": "partial", "decay_days": 14},
  {"text": "If you find a stone on the path with a single line cut into it, thats a Hala-mark. She knows the safe ways.", "truthiness": "true", "decay_days": 90},
  {"text": "Theres a hollow oak near the eastern stream where someone left a sword in 12-something. The bark grew around the hilt.", "truthiness": "true", "decay_days": 90},
  {"text": "The Whisperwood owls hoot in patterns. Six-three-six means a stranger. Three-two-three means trouble. Twelve straight means the Antler-King.", "truthiness": "false", "decay_days": 7},
  {"text": "A goblin once tried to surrender. The pack killed him. The hunters left him buried under a flat stone.", "truthiness": "true", "decay_days": 30},
  {"text": "Mushrooms with white caps will end your week. Mushrooms with orange caps will start it well. Brown-cap is friend; white-cap is final.", "truthiness": "true", "decay_days": 365},
  {"text": "The river bends three times before it leaves the wood. The bends are old as the Sundering; their order has never changed.", "truthiness": "true", "decay_days": 365},
  {"text": "A Stag-Court light moves on a Foxthaw evening. It moves at walking pace. If you walk faster than it, it falls behind.", "truthiness": "partial", "decay_days": 30},
  {"text": "Theres a part of the wood where you can hear a flute. No one has found the flute. The note is always the same.", "truthiness": "true", "decay_days": 60},
  {"text": "The goblin warlords axe has a carved handle. The carving is older than the goblin warlord. No one taught him to make it.", "truthiness": "partial", "decay_days": 21},
  {"text": "Three travelers went into the Whisperwood last Smokerise to find a treasure. Two came back rich. One came back wise.", "truthiness": "false", "decay_days": 14},
  {"text": "Lyra collects mosswort by feel. She closes her eyes when she picks it. The mosswort is sharper that way; the herb is willing.", "truthiness": "true", "decay_days": 60},
  {"text": "Theres a stone bridge in the deep wood that does not appear on any map. Its been there since before maps.", "truthiness": "true", "decay_days": 90},
  {"text": "Goblin scouts hate the smell of pine-resin. Roan keeps a stick of it in his pocket on patrol days.", "truthiness": "true", "decay_days": 60},
  {"text": "The Whisperwood has eight kinds of silence. Hunters know seven. The eighth is the silence after the goblin drums stop.", "truthiness": "partial", "decay_days": 21},
  {"text": "A wolf once led a lost child back to the forest line. The wolf was scarred on its left flank. The child was three.", "truthiness": "true", "decay_days": 90},
  {"text": "Theres a clearing east of the goblin camp where the trees are dead but standing. Crows do not roost there. Hala calls it *kerritha-place.*", "truthiness": "true", "decay_days": 90},
  {"text": "The fey market has a stall with a sign no one can read. Some say its the Courts. Some say its older than the Court.", "truthiness": "partial", "decay_days": 30},
  {"text": "If a fox crosses your path twice in one evening, turn around. The third time will be at the forest line.", "truthiness": "partial", "decay_days": 21},
  {"text": "A goblin cookfire smells of charred mushroom and burnt bone. Bone they can eat; mushroom they cannot.", "truthiness": "true", "decay_days": 60},
  {"text": "The Pale Wyrms breath blew the Whisperwood into being. The trees lean north because of it. Not all of them, but enough.", "truthiness": "partial", "decay_days": 365},
  {"text": "There is a tree that bleeds amber when struck. It is fifteen paces past the second river-bend. Dont strike it. The amber remembers who hit.", "truthiness": "true", "decay_days": 90},
  {"text": "The Antler Crowns seat is real. The cost is real. Walking close is the gift; sitting is the door. *Vellum is patient.*", "truthiness": "true", "decay_days": 365}
]
}
