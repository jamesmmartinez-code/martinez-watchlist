[gd_resource type="Resource" format=3]

[resource]
metadata/data = {
"id": "briarwood_rumors",
"region_origin": "briarwood",
"freshness_decay_days_default": 14,
"lines": [
  {"text": "Bram says the inns cellar is older than the village. Hes not wrong — a Sundering-stone wall holds it up.", "truthiness": "true", "decay_days": 60},
  {"text": "Maras coin pouches jingle different on a Reapmoon morning. Some say shes carrying southern silver mixed with steppe copper.", "truthiness": "partial", "decay_days": 21},
  {"text": "The widow Olen leaves her shutters open on Longnight. They say she still expects her husband home.", "truthiness": "true", "decay_days": 30},
  {"text": "If you sweep the village square widdershins on Honeysong Eve, Maeve will know. No one knows how she knows.", "truthiness": "partial", "decay_days": 21},
  {"text": "The Holt boy can name every horse on the pasture, but he calls his own sheep Mabel even though Mabel is a ewe.", "truthiness": "true", "decay_days": 90},
  {"text": "Theres a Sundering-mark on the well rim. Children dare each other to touch it. Maeve says it remembers them when they do.", "truthiness": "true", "decay_days": 60},
  {"text": "Edda forged a saber in Reapmoon last year. It went south with a man who didnt buy it. The smith has not asked after it.", "truthiness": "partial", "decay_days": 30},
  {"text": "Bram once outdrank a Stone Crown rider and the rider left a circlet of horsehair under the bench. Bram wont say where it is now.", "truthiness": "false", "decay_days": 14},
  {"text": "If you drop a copper in the well on a Foxthaw evening, Erris keeps it. If you drop a silver, Vellum keeps it. The well never gives back coins.", "truthiness": "partial", "decay_days": 60},
  {"text": "Maeves walking stick has names cut into it. Children count the rings; the count never matches twice.", "truthiness": "true", "decay_days": 90},
  {"text": "A peddler tried to sell a clockwork bird in the square last spring. Maeve told him to leave by sundown. He left by midday.", "truthiness": "true", "decay_days": 30},
  {"text": "Theres a fox that comes to the village edge every Foxthaw evening. Lyra leaves a strip of dried mutton on the stoop. The fox does not eat it.", "truthiness": "true", "decay_days": 60},
  {"text": "Some say the village banner was sewn by Esca, Maeves mother. Some say it was stitched by Escas mother before her.", "truthiness": "partial", "decay_days": 90},
  {"text": "The Marsh-end farmstead has a horseshoe nailed above the door upside-down. They say it lets the luck pour out. They say it on purpose.", "truthiness": "true", "decay_days": 60},
  {"text": "A Briarwood child once wandered to the forest line on Foxthaw and came back grown three years older. Maeve does not confirm; Maeve does not deny.", "truthiness": "false", "decay_days": 14},
  {"text": "Innkeeper Bram never serves the same stew twice in one season. He keeps a notebook. The notebook is older than he is.", "truthiness": "false", "decay_days": 14},
  {"text": "The bell at the village meeting-stone has a crack from the Sundering. It still rings true; the crack is decoration now.", "truthiness": "partial", "decay_days": 60},
  {"text": "Roan keeps a horseshoe above his pasture-fence post. Different horseshoe than Maeves, but the same Sundering-iron forge-mark.", "truthiness": "true", "decay_days": 60},
  {"text": "On a Smokerise night you can hear a fiddle from no house. The villagers dont mention it. The cats sit at the doorways.", "truthiness": "partial", "decay_days": 21},
  {"text": "Mara once paid Bram with a single thirre-old coin. Bram framed it. Its behind the bar; ask if you want to see it.", "truthiness": "true", "decay_days": 90},
  {"text": "The cobbles in the lane outside Maeves house are warmer than the rest. Snow doesnt stick there. No one has ever explained it.", "truthiness": "true", "decay_days": 60},
  {"text": "The blacksmiths daughter — she didnt have one. Dont ask Edda about her. The rumor itself is the lie.", "truthiness": "false", "decay_days": 7},
  {"text": "On a Lambmoon morning, the swallows return and circle the inn three times before settling. Bram counts. Hes never been wrong.", "truthiness": "true", "decay_days": 60},
  {"text": "The pond fills from a spring no one can find. Kids try every Sunpetal. The water tastes a little of iron.", "truthiness": "true", "decay_days": 90},
  {"text": "Theres a stone in the meadow that doesnt throw a shadow at noon. Lyra knows the stone. Lyra hasnt named it.", "truthiness": "partial", "decay_days": 30},
  {"text": "Hala once crossed the Whisperwood alone in Wolfwake. Came back with no stories and a different sword. The villagers asked once, and never again.", "truthiness": "true", "decay_days": 60},
  {"text": "If you sleep on the bench under the oak by the well, you wake with one good idea. Children sleep there in shifts.", "truthiness": "partial", "decay_days": 30},
  {"text": "The Holt sisters leave a candle at the crossroads stone every Erris-day. The candle is always gone by morning. Wax stays.", "truthiness": "true", "decay_days": 60},
  {"text": "A merchant from the smoke-cities once tried to buy the village. Maeve laughed. The merchant left in tears. No one knows why he cried.", "truthiness": "false", "decay_days": 14},
  {"text": "Theres a name on the meeting-stone that wasnt there last year. No one carved it. Maeve says: *Vellum is patient.*", "truthiness": "partial", "decay_days": 21},
  {"text": "Brams dog answers to no one. Bram does not own a dog. The dog comes anyway, on cold nights.", "truthiness": "true", "decay_days": 30},
  {"text": "Every seventeenth Honeysong, a lantern stays lit on the pond until dawn. Even when knocked over. Even when wet.", "truthiness": "partial", "decay_days": 30}
]
}
